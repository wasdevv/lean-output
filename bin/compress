#!/usr/bin/env ruby
# PostToolUse hook entry point. Fail-safe by design: any error means
# passthrough (exit 0, no stdout) so a bug here can never break a session.
# Set LEAN_OUTPUT_DEBUG=/some/file to log payloads and decisions.

# Loaded without RubyGems, which is what the hook is launched with: measured on
# a normal laptop, `ruby -e ""` costs 45ms and `ruby --disable=gems -e ""` costs
# 8ms, and this process runs on every single tool call. End to end that is 71ms
# against 31ms for byte-identical output.
#
# Everything required here is a default gem, so it resolves from the stdlib load
# path with RubyGems absent. The rescue is for the install where one of them was
# replaced by a real gem: RubyGems comes back, the requires are retried, and the
# hook is merely as slow as it used to be. A LoadError out here would take the
# whole hook down, which is the one thing this file promises never to do.
#
# And if it cannot be loaded at all, this file's whole promise applies: any
# error means passthrough, exit 0, no stdout. That promise used to have a hole
# exactly here, because the requires sat outside the rescue that makes it.
#
# Not hypothetical. A `/plugin update` left a cache directory holding `bin`,
# `hooks` and `spec` but no `lib` — the manifest said 1.7.0, the hooks pointed
# at this file, and this file exited 1 with a stack trace on stderr before
# every single tool result. A half-installed plugin has to degrade to doing
# nothing, which is what the user had before installing it.
begin
  require "json"
  require_relative "../lib/lean_output"
rescue LoadError
  begin
    require "rubygems"
    require "json"
    require_relative "../lib/lean_output"
  rescue LoadError
    exit 0
  end
end

def debug(message)
  return unless ENV["LEAN_OUTPUT_DEBUG"]

  File.write(ENV["LEAN_OUTPUT_DEBUG"], "[#{Time.now}] #{message}\n", mode: "a")
end

started = Process.clock_gettime(Process::CLOCK_MONOTONIC)

begin
  # The payload is JSON, so it is UTF-8 by definition — but `read` tags it with
  # the locale's encoding, and under LANG=C that is US-ASCII. The strings inside
  # then carry valid UTF-8 bytes under a label saying they cannot exist, and the
  # first `count`/`scan` raises into the rescue below: silent passthrough, on
  # 45.7% of the corpus by bytes. The environment is not entitled to an opinion
  # about the encoding of a format that defines its own.
  input = $stdin.read.force_encoding(Encoding::UTF_8)
  debug("payload: #{input[0, 2000]}")
  result = LeanOutput::Runner.call(JSON.parse(input))
  # JSON.generate, not .bytesize: updatedToolOutput now mirrors the tool's own
  # shape, so it is a Hash as often as a String and a size call would raise —
  # into the rescue below, where turning debug on would turn the plugin off.
  debug(result ? "compressed: #{JSON.generate(result)[0, 400]}" : "passthrough")
  puts JSON.generate(result) if result
rescue StandardError => e
  debug("error: #{e.class}: #{e.message}")
end

# This process runs on every single tool call, and nothing has ever measured
# what it costs. A hook that spends 200ms is spending it in front of the user,
# on every call, forever — a bill nobody was shown. Off unless asked, appended
# rather than aggregated, so the reader can see the tail and not just a mean.
LeanOutput::Profile.record(Process.clock_gettime(Process::CLOCK_MONOTONIC) - started)

exit 0
