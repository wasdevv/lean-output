{
  "modules": ["./compaction.js"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "ruby --disable=gems ${CLAUDE_PLUGIN_ROOT}/bin/compress"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "ruby --disable=gems ${CLAUDE_PLUGIN_ROOT}/bin/compress"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "ruby --disable=gems ${CLAUDE_PLUGIN_ROOT}/bin/compress"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ruby --disable=gems ${CLAUDE_PLUGIN_ROOT}/bin/compress"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "ruby --disable=gems ${CLAUDE_PLUGIN_ROOT}/bin/compress"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "ruby --disable=gems ${CLAUDE_PLUGIN_ROOT}/bin/compress"
          }
        ]
      }
    ]
  }
}
